{
    "manifest_version": 3,
    "name": "SiteBlocker",
    "version": "1.0",
    "description": "This browser extension allows user to block web sites",

    "permissions": [
      "storage",
      "tabs",
      "activeTab",
      "scripting"],
    
    "action": {
      "default_popup": "popup/popup.html"
    },
    "icons": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    },

    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "scripts.js"
    },
    "web_accessible_resources": [{
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }]
  }